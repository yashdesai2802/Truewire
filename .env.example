# TrueWire Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# AI Provider Configuration
# Supported providers: gemini | openai | anthropic | mock
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Optional Alternative Provider Examples:
# For OpenAI:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
#
# For Anthropic Claude:
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-sonnet-20241022

# News Configuration
# Refresh interval in milliseconds (default: 300000 = 5 minutes)
NEWS_REFRESH_INTERVAL=300000
# Max items per feed fetch
NEWS_MAX_ITEMS=100
# Optional NewsAPI key (if using NewsAPI as secondary source)
NEWS_API_KEY=
